# Copy to .env.local if you need any of these. Vite only exposes VITE_* variables.

# Leave unset to use "/api" (vite proxy locally, vercel rewrite in production).
# VITE_API_URL=https://your-api.example.com/api

# Shows a "Try the demo account" button on the login page (run `pnpm seed` in backend first).
# VITE_DEMO_EMAIL=demo@tasknix.app
# VITE_DEMO_PASSWORD=demo1234
