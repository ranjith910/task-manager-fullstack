# Copy this file to .env and fill in real values. Never commit .env.

# "development" locally, "production" when deployed.
NODE_ENV=development
PORT=5000

# Local: mongodb://127.0.0.1:27017/task_manager
# Production: your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/task_manager

# Long random string used to sign login tokens (min 32 chars in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed to call the API, comma-separated.
CLIENT_URL=http://localhost:5173

# Optional. "lax" (default) when the frontend proxies /api to this server.
# Set to "none" only if the browser calls the API on a different site directly.
# COOKIE_SAME_SITE=lax

# Optional. Number of proxies in front of the app (defaults to 1 in production, see docs/DEPLOYMENT.md).
# TRUST_PROXY=1

# Optional. MongoDB server for `pnpm test`, from here or the shell. Each test file makes
# (and drops) its own tasknix_test_<pid> database, so any database name in the URI is ignored.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017

# Optional. The shared demo login created by `pnpm seed` (its profile and password can't be changed).
# DEMO_EMAIL=demo@tasknix.app
# DEMO_PASSWORD=demo1234
# Set to "true" to reset the demo account's tasks every time the server starts.
# RESET_DEMO_ON_START=false
